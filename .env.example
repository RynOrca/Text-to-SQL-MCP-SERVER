# 把本文件复制为 .env，填入真实值。
# .env 已经在 .gitignore 里，不会被提交，也不会被别人看到。
#
#   Windows 复制：  copy .env.example .env
#   macOS/Linux：  cp .env.example .env

# ---------- 必填 ----------

# 你的密钥。填进去之后不要提交、不要截图、不要发到聊天窗口。
OPENAI_API_KEY=

# 模型服务的地址。不同服务商不一样，填错会报 404：
#   DeepSeek          https://api.deepseek.com/v1
#   阿里通义（兼容模式）https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱              https://open.bigmodel.cn/api/paas/v4
#   OpenAI            https://api.openai.com/v1
#   本地部署（Ollama） http://127.0.0.1:11434/v1
OPENAI_BASE_URL=

# 模型名。常见写法：
#   deepseek-chat / qwen-plus / glm-4-plus / gpt-4o-mini / qwen2.5:7b
OPENAI_MODEL=

# ---------- 选填 ----------

# 数据库。跑 `python scripts/setup.py` 会自动写好这几行，也可以手填。
# sqlite：
#   ASKDATA_DIALECT=sqlite
#   ASKDATA_DB=data/demo_shop.db
# mysql / postgres：
#   ASKDATA_DIALECT=mysql
#   ASKDATA_DSN=mysql://用户名:密码@主机:3306/库名

# 数据字典位置（表和字段的中文说明，客户的库只读时放这里）
# ASKDATA_DICT=data/schema_meta.yaml

# 把模型后端从 mock 切到真实接口。不填这一行，程序仍然会用离线的模拟后端。
LLM_PROVIDER=openai_compatible

# 采样温度。数据问答要稳定，建议 0。
OPENAI_TEMPERATURE=0
